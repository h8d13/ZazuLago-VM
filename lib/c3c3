#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <time.h>
#include <pthread.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>
#include <errno.h>

// Larger buffer size for higher throughput
#define BUFFER_SIZE (64 * 1024 * 1024) // 64MB per thread
#define MAX_THREADS 32
#define SECTOR_SIZE 512 // For O_DIRECT alignment and header preservation

typedef struct {
    uint8_t *buffer;
    uint8_t *output_buffer;
    size_t length;
    uint64_t magic_number;
    size_t thread_id;
} ThreadData;

// Optimized processing function
void process_data(uint8_t *buffer, size_t length, uint64_t magic_number) {
    // Process 64-bit chunks
    uint64_t *buffer64 = (uint64_t *)buffer;
    size_t length64 = length / 8;
    
    // Manual loop unrolling for better performance
    size_t i = 0;
    for (; i + 3 < length64; i += 4) {
        // Process 4 chunks at once
        buffer64[i] ^= magic_number;
        buffer64[i] = (buffer64[i] << 3) | (buffer64[i] >> 61);
        buffer64[i] ^= (magic_number << 17) | (magic_number >> 47);
        magic_number = ((magic_number * 0x5851F42D4C957F2DULL) + 0x14057B7EF767814FULL) & 0xFFFFFFFFFFFFFFFFULL;
        
        buffer64[i+1] ^= magic_number;
        buffer64[i+1] = (buffer64[i+1] << 3) | (buffer64[i+1] >> 61);
        buffer64[i+1] ^= (magic_number << 17) | (magic_number >> 47);
        magic_number = ((magic_number * 0x5851F42D4C957F2DULL) + 0x14057B7EF767814FULL) & 0xFFFFFFFFFFFFFFFFULL;
        
        buffer64[i+2] ^= magic_number;
        buffer64[i+2] = (buffer64[i+2] << 3) | (buffer64[i+2] >> 61);
        buffer64[i+2] ^= (magic_number << 17) | (magic_number >> 47);
        magic_number = ((magic_number * 0x5851F42D4C957F2DULL) + 0x14057B7EF767814FULL) & 0xFFFFFFFFFFFFFFFFULL;
        
        buffer64[i+3] ^= magic_number;
        buffer64[i+3] = (buffer64[i+3] << 3) | (buffer64[i+3] >> 61);
        buffer64[i+3] ^= (magic_number << 17) | (magic_number >> 47);
        magic_number = ((magic_number * 0x5851F42D4C957F2DULL) + 0x14057B7EF767814FULL) & 0xFFFFFFFFFFFFFFFFULL;
    }
    
    // Handle remaining chunks
    for (; i < length64; i++) {
        buffer64[i] ^= magic_number;
        buffer64[i] = (buffer64[i] << 3) | (buffer64[i] >> 61);
        buffer64[i] ^= (magic_number << 17) | (magic_number >> 47);
        magic_number = ((magic_number * 0x5851F42D4C957F2DULL) + 0x14057B7EF767814FULL) & 0xFFFFFFFFFFFFFFFFULL;
    }
    
    // Handle remaining bytes
    uint8_t *remainder = buffer + (length64 * 8);
    size_t remaining_bytes = length % 8;
    
    for (size_t i = 0; i < remaining_bytes; i++) {
        remainder[i] ^= (uint8_t)(magic_number >> (8 * (i % 8)));
    }
}

void* thread_process_data(void *arg) {
    ThreadData *data = (ThreadData *)arg;
    
    // Generate a unique seed for this thread based on thread_id
    uint64_t thread_magic = data->magic_number ^ (data->thread_id * 0x123456789ABCDEFULL);
    
    process_data(data->buffer, data->length, thread_magic);
    
    // Copy to output buffer (if different)
    if (data->buffer != data->output_buffer && data->output_buffer != NULL) {
        memcpy(data->output_buffer, data->buffer, data->length);
    }
    
    return NULL;
}

// Function to get number of available CPU cores
int get_num_cores() {
    int num_cores = 1; // Default to 1 if detection fails
    
    #ifdef _SC_NPROCESSORS_ONLN
    num_cores = sysconf(_SC_NPROCESSORS_ONLN);
    if (num_cores < 1) num_cores = 1;
    #endif
    
    return num_cores;
}

// Aligned memory allocation for direct I/O
void* aligned_alloc_wrapper(size_t alignment, size_t size) {
    void *ptr = NULL;
    
    #if defined(_POSIX_C_SOURCE) && _POSIX_C_SOURCE >= 200112L
    if (posix_memalign(&ptr, alignment, size) != 0) {
        return NULL;
    }
    return ptr;
    #else
    // Fallback for non-POSIX systems
    ptr = malloc(size + alignment);
    if (!ptr) return NULL;
    
    uintptr_t addr = (uintptr_t)ptr;
    uintptr_t aligned = (addr + alignment - 1) & ~(alignment - 1);
    return (void*)aligned;
    #endif
}

int main(int argc, char *argv[]) {
    if (argc < 4 || argc > 6) {
        fprintf(stderr, "Usage: %s <input_file> <output_file> <magic_number> [num_threads] [preserve_header_size]\n", argv[0]);
        return 1;
    }
    
    const char *input_filename = argv[1];
    const char *output_filename = argv[2];
    uint64_t magic_number = strtoull(argv[3], NULL, 0);
    
    // Determine number of threads (default to available cores)
    int num_threads = get_num_cores();
    if (argc >= 5) {
        int requested_threads = atoi(argv[4]);
        if (requested_threads > 0) {
            num_threads = requested_threads;
        }
    }
    if (num_threads > MAX_THREADS) num_threads = MAX_THREADS;
    
    // Check if we should preserve header bytes (default to sector size)
    size_t preserve_header_size = SECTOR_SIZE;
    if (argc >= 6) {
        size_t requested_header_size = strtoull(argv[5], NULL, 0);
        if (requested_header_size >= 0) {
            preserve_header_size = requested_header_size;
        }
    }
    
    printf("Using %d threads on this system\n", num_threads);
    
    // Get file size
    struct stat st;
    if (stat(input_filename, &st) != 0) {
        perror("Failed to get file size");
        return 1;
    }
    size_t file_size = st.st_size;
    
    // Adjust number of threads for small files
    if (file_size < num_threads * BUFFER_SIZE / 2) {
        num_threads = (file_size / BUFFER_SIZE) + 1;
        if (num_threads < 1) num_threads = 1;
        printf("Adjusted to %d threads based on file size\n", num_threads);
    }
    
    // Open files with direct I/O if possible
    int input_flags = O_RDONLY;
    int output_flags = O_WRONLY | O_CREAT | O_TRUNC;
    
    #ifdef O_DIRECT
    input_flags |= O_DIRECT;
    output_flags |= O_DIRECT;
    printf("Using direct I/O\n");
    #endif
    
    int input_fd = open(input_filename, input_flags, 0);
    if (input_fd < 0) {
        // If O_DIRECT fails, retry without it
        if (errno == EINVAL) {
            input_flags &= ~O_DIRECT;
            input_fd = open(input_filename, input_flags, 0);
        }
        
        if (input_fd < 0) {
            perror("Failed to open input file");
            return 1;
        }
    }
    
    int output_fd = open(output_filename, output_flags, 0644);
    if (output_fd < 0) {
        // If O_DIRECT fails, retry without it
        if (errno == EINVAL) {
            output_flags &= ~O_DIRECT;
            output_fd = open(output_filename, output_flags, 0644);
        }
        
        if (output_fd < 0) {
            perror("Failed to open output file");
            close(input_fd);
            return 1;
        }
    }
    
    // Calculate optimal alignment for direct I/O
    size_t alignment = SECTOR_SIZE;
    
    // Start timing
    struct timespec start_time, end_time;
    clock_gettime(CLOCK_MONOTONIC, &start_time);
    
    // Handle header preservation
    size_t total_processed = 0;
    if (preserve_header_size > 0 && file_size > preserve_header_size) {
        // Allocate buffer for header
        uint8_t *header_buffer = aligned_alloc_wrapper(alignment, 
            ((preserve_header_size + alignment - 1) / alignment) * alignment);
        
        if (!header_buffer) {
            perror("Failed to allocate memory for header preservation");
            close(output_fd);
            close(input_fd);
            return 1;
        }
        
        // Read header
        lseek(input_fd, 0, SEEK_SET);
        ssize_t header_read = read(input_fd, header_buffer, preserve_header_size);
        if (header_read < 0) {
            perror("Failed to read file header");
            free(header_buffer);
            close(output_fd);
            close(input_fd);
            return 1;
        }
        
        // Write header to output without processing
        lseek(output_fd, 0, SEEK_SET);
        ssize_t header_written = write(output_fd, header_buffer, preserve_header_size);
        if (header_written < 0) {
            perror("Failed to write file header");
            free(header_buffer);
            close(output_fd);
            close(input_fd);
            return 1;
        }
        
        free(header_buffer);
        
        // Set starting point for processing
        total_processed = preserve_header_size;
        printf("Preserving first %zu bytes as header\n", preserve_header_size);
    }
    
    // Allocate memory for thread data
    ThreadData *thread_data = malloc(num_threads * sizeof(ThreadData));
    pthread_t *threads = malloc(num_threads * sizeof(pthread_t));
    
    if (!thread_data || !threads) {
        perror("Failed to allocate memory for thread data");
        free(threads);
        free(thread_data);
        close(output_fd);
        close(input_fd);
        return 1;
    }
    
    // Pre-allocate buffers for all threads
    uint8_t **input_buffers = malloc(num_threads * sizeof(uint8_t*));
    uint8_t **output_buffers = malloc(num_threads * sizeof(uint8_t*));
    
    if (!input_buffers || !output_buffers) {
        perror("Failed to allocate buffer pointers");
        free(output_buffers);
        free(input_buffers);
        free(threads);
        free(thread_data);
        close(output_fd);
        close(input_fd);
        return 1;
    }
    
    // Allocate aligned buffers for direct I/O
    for (int i = 0; i < num_threads; i++) {
        size_t aligned_size = ((BUFFER_SIZE + alignment - 1) / alignment) * alignment;
        input_buffers[i] = aligned_alloc_wrapper(alignment, aligned_size);
        output_buffers[i] = aligned_alloc_wrapper(alignment, aligned_size);
        
        if (!input_buffers[i] || !output_buffers[i]) {
            perror("Failed to allocate aligned buffers");
            
            // Clean up already allocated buffers
            for (int j = 0; j <= i; j++) {
                free(input_buffers[j]);
                free(output_buffers[j]);
            }
            
            free(output_buffers);
            free(input_buffers);
            free(threads);
            free(thread_data);
            close(output_fd);
            close(input_fd);
            return 1;
        }
    }
    
    // Process file in chunks, starting after the preserved header
    lseek(input_fd, total_processed, SEEK_SET);
    lseek(output_fd, total_processed, SEEK_SET);
    
    while (total_processed < file_size) {
        int active_threads = 0;
        
        // Read chunks and assign to threads
        for (int i = 0; i < num_threads && total_processed < file_size; i++) {
            size_t bytes_to_read = BUFFER_SIZE;
            if (total_processed + bytes_to_read > file_size) {
                bytes_to_read = file_size - total_processed;
            }
            
            // Align read size for direct I/O if needed
            size_t aligned_bytes = bytes_to_read;
            if (input_flags & O_DIRECT) {
                aligned_bytes = ((bytes_to_read + alignment - 1) / alignment) * alignment;
            }
            
            // Read chunk from file
            ssize_t bytes_read = read(input_fd, input_buffers[i], aligned_bytes);
            if (bytes_read < 0) {
                perror("Error reading from file");
                
                for (int j = 0; j < num_threads; j++) {
                    free(input_buffers[j]);
                    free(output_buffers[j]);
                }
                
                free(output_buffers);
                free(input_buffers);
                free(threads);
                free(thread_data);
                close(output_fd);
                close(input_fd);
                return 1;
            }
            
            // Actual bytes to process (not including alignment padding)
            size_t actual_bytes = bytes_read;
            if (actual_bytes > bytes_to_read) {
                actual_bytes = bytes_to_read;
            }
            
            thread_data[i].buffer = input_buffers[i];
            thread_data[i].output_buffer = output_buffers[i];
            thread_data[i].length = actual_bytes;
            thread_data[i].magic_number = magic_number;
            thread_data[i].thread_id = i;
            
            int ret = pthread_create(&threads[i], NULL, thread_process_data, &thread_data[i]);
            if (ret != 0) {
                fprintf(stderr, "Failed to create thread %d\n", i);
                
                for (int j = 0; j < num_threads; j++) {
                    free(input_buffers[j]);
                    free(output_buffers[j]);
                }
                
                free(output_buffers);
                free(input_buffers);
                free(threads);
                free(thread_data);
                close(output_fd);
                close(input_fd);
                return 1;
            }
            
            active_threads++;
            total_processed += actual_bytes;
        }
        
        // Wait for all active threads to complete
        for (int i = 0; i < active_threads; i++) {
            pthread_join(threads[i], NULL);
            
            // Prepare aligned write size
            size_t bytes_to_write = thread_data[i].length;
            size_t aligned_bytes = bytes_to_write;
            if (output_flags & O_DIRECT) {
                aligned_bytes = ((bytes_to_write + alignment - 1) / alignment) * alignment;
            }
            
            // Write processed data to output file
            ssize_t bytes_written = write(output_fd, output_buffers[i], aligned_bytes);
            if (bytes_written < 0) {
                perror("Failed to write to output file");
                
                for (int j = 0; j < num_threads; j++) {
                    free(input_buffers[j]);
                    free(output_buffers[j]);
                }
                
                free(output_buffers);
                free(input_buffers);
                free(threads);
                free(thread_data);
                close(output_fd);
                close(input_fd);
                return 1;
            }
        }
    }
    
    // Ensure the file size is exactly right (especially important for structured formats)
    if (ftruncate(output_fd, file_size) != 0) {
        perror("Warning: Failed to set exact file size");
    }
    
    // Calculate and display performance metrics
    clock_gettime(CLOCK_MONOTONIC, &end_time);
    double elapsed_seconds = (end_time.tv_sec - start_time.tv_sec) + 
                             (end_time.tv_nsec - start_time.tv_nsec) / 1e9;
    double speed_mbps = (file_size / (1024.0 * 1024.0)) / elapsed_seconds;
    
    printf("Processed %zu bytes in %.3f seconds (%.2f MB/s) using %d threads\n", 
           file_size, elapsed_seconds, speed_mbps, num_threads);
    
    // Clean up
    for (int i = 0; i < num_threads; i++) {
        free(input_buffers[i]);
        free(output_buffers[i]);
    }
    
    free(output_buffers);
    free(input_buffers);
    free(thread_data);
    free(threads);
    close(output_fd);
    close(input_fd);
    
    return 0;
}
